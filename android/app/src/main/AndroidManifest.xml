<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Jajan Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Intent filter for Quick-Log action from widget and quick tile -->
            <intent-filter>
                <action android:name="ACTION_QUICK_LOG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home Screen AppWidget Receiver -->
        <receiver
            android:name=".JajanWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hellorayy.jajan_tracker.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jajan_widget_info" />
        </receiver>

        <!-- Shopee Accessibility Service -->
        <service
            android:name=".ShopeeAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shopee_accessibility_service_config" />
        </service>

        <!-- Quick Settings Tile Service (Panel Pintasan Atas) -->
        <service
            android:name=".JajanQuickTileService"
            android:label="Catat Jajan"
            android:icon="@drawable/ic_quick_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Floating Bubble & Calculator Service -->
        <service
            android:name=".FloatingBubbleService"
            android:enabled="true"
            android:exported="false" />

        <!-- Notification Listener Service for zero-heat passive payment detection -->
        <service
            android:name=".JajanNotificationListenerService"
            android:label="Jajan Auto-Detection"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- BroadcastReceiver for 1-tap notification actions -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hellorayy.jajan_tracker.ACTION_AUTO_LOG" />
                <action android:name="com.hellorayy.jajan_tracker.ACTION_OPEN_CALC" />
                <action android:name="com.hellorayy.jajan_tracker.ACTION_DISMISS" />
            </intent-filter>
        </receiver>

        <!-- Quick Tile Trampoline Activity (Invisible / Translucent) -->
        <activity
            android:name=".QuickTileTrampolineActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- Package visibility query for Shopee -->
        <package android:name="com.shopee.id" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
