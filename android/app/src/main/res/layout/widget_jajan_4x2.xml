<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark_4x2">

    <!-- Coins Illustration from pen.dev (Aligned to bottom-right with pre-clipped bounds) -->
    <ImageView
        android:id="@+id/iv_widget_coins"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|bottom"
        android:contentDescription="Coins Illustration"
        android:scaleType="fitEnd"
        android:src="@drawable/coins_illustration" />

    <!-- Foreground Content Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <!-- Top Header Row: Greeting & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:text="Hi, Raditya Rayhan"
                android:textColor="#EDEDED"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="Batas jajan hari ini"
                android:textColor="#A1A1AA"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Center Hero Row: Large Nominal + /hari (Baseline Aligned) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_widget_daily_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.025"
                    android:text="Rp 0"
                    android:textColor="#EDEDED"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_daily_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="/hari"
                    android:textColor="#A1A1AA"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Metrics Row: Uang Masuk Mingguan & Uang Keluar Keseluruhan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Uang Masuk Mingguan (Green) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="↓"
                    android:textColor="#4ADE80"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.012"
                    android:text="Rp 0"
                    android:textColor="#4ADE80"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Uang Keluar Keseluruhan (Red) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="↑"
                    android:textColor="#F87171"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_spent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.012"
                    android:text="Rp 0"
                    android:textColor="#F87171"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
