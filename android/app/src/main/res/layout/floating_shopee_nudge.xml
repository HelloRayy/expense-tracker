<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_nudge_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_nudge"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛍️"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/btn_nudge_click"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingat Sisa Uang Jajan!"
            android:textColor="#FDBA74"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_nudge_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 125.000"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:background="#334155" />

    <TextView
        android:id="@+id/btn_nudge_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
